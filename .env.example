# Copia este archivo a .env. Frontend es la ÚNICA raíz pública.
APP_ENV=local
APP_URL=http://localhost:8080
APP_PREVIEW_ENABLED=false
APP_TIMEZONE=America/Lima

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ClassicFlix
DB_USERNAME=classicflix
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Ruta al certificado CA de MySQL si el servidor requiere TLS.
DB_SSL_CA=

AWS_REGION=us-east-1
AWS_BUCKET=
# En EC2 deja estas claves vacías y utiliza el rol IAM de la instancia.
# Para desarrollo también puedes usar el perfil configurado por AWS CLI.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE=false

REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TLS=false
REDIS_TIMEOUT=0.5
CATALOG_CACHE_TTL=300

MEDIA_TRAILER_TTL=900
MEDIA_MOVIE_TTL=3600
MEDIA_POSTER_TTL=900
UPLOAD_TRAILER_MAX_BYTES=104857600
UPLOAD_POSTER_MAX_BYTES=5242880
UPLOAD_MOVIE_MAX_BYTES=2147483648

