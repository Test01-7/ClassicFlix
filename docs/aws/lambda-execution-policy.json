{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadClassicFlixPosters",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::BUCKET_ELEGIDO/classicflix/*/portada/*"
    },
    {
      "Sid": "WriteClassicFlixThumbnails",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::BUCKET_ELEGIDO/miniaturas/v1/*"
    }
  ]
}
